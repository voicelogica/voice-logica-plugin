{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "voice-logica": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@voicelogica/mcp-server"
      ],
      "env": {
        "VOICE_LOGICA_API_KEY": "${VOICE_LOGICA_API_KEY}"
      }
    }
  }
}
